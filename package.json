    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.7.0",
    "eslint-plugin-oxlint": "~1.73.0",
    "eslint-plugin-storybook": "^10.5.4",
    "eslint-plugin-vue": "~10.9.2",
    "happy-dom": "^20.11.1",
    "jiti": "^2.7.0",
    "npm-run-all2": "^9.0.2",
    "oxlint": "~1.73.0",
    "playwright": "^1.62.0",
    "storybook": "^10.5.4",
    "typescript": "~6.0.0",
    "vite": "^8.1.5",
    "vite-plugin-vue-devtools": "^8.1.5",
